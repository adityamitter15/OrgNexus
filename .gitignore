# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.so

# Virtualenv
venv/
.venv/
env/

# Django
*.log
local_settings.py
.env
.env.*

# Migrations are kept under version control on purpose so the marker can
# replay schema history. Do NOT add migrations/ here.

# Media uploads (avatars etc.) — only the directory layout is committed.
media/*
!media/.gitkeep

# IDE/editor
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# OS / coverage
.coverage
htmlcov/

# Build artefacts
*.egg-info/
build/
dist/

# Keep the SQLite DB out of git until it has seed data we want shipped.
# The brief says to include the database, so the marker version of
# db.sqlite3 is generated by `manage.py loaddata fixtures/seed.json`
# at run time - see README.
db.sqlite3
db.sqlite3-journal

# Local dev email outbox - file-based email backend dumps .eml files
# here so the marker can read them in their browser.
dev_outbox/
